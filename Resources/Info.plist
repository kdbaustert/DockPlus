<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>DockPlus</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>dev.kennyb.dockplus</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DockPlus</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0-beta.2</string>
	<key>CFBundleVersion</key>
	<string>42</string>
	<!-- Updates, through Sparkle, from a feed served by GitHub Pages off the gh-pages branch. The
	     release workflow adds each release's entry to it; the releases themselves carry only the
	     zip. build.sh deletes this key from local builds, so a development copy never updates
	     itself out from under its developer. -->
	<key>SUFeedURL</key>
	<string>https://kdbaustert.github.io/DockPlus/appcast.xml</string>
	<!-- The public half of the EdDSA key every release is signed with. Sparkle checks each
	     download against it before unpacking, so nobody else can ship DockPlus's users an update.
	     The private half is in the login keychain under the "DockPlus" account — each app has its
	     own key, and the default account belongs to another app — where release.sh's
	     generate_appcast reads it. -->
	<key>SUPublicEDKey</key>
	<string>XbUIRhcrsRLXQ7nojB3Fw724IiGKnoAdNjgipSkvkcU=</string>
	<!-- Check daily, but install only when asked. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>DockPlus asks Finder to empty the Trash, and Spotify or Music what is playing for the Now Playing widget.</string>
	<!-- Asked for only when the Calendar widget is turned on. No entitlement goes with it: build.sh
	     signs without the hardened runtime, which is what would require
	     com.apple.security.personal-information.calendars. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DockPlus shows your next event today in the Calendar widget.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.kennyb.dockplus.item</string>
			<key>UTTypeDescription</key>
			<string>DockPlus Item</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
